{
  "consumer": {
    "name": "order-service"
  },
  "interactions": [
    {
      "contents": {
        "content": {
          "dishId": 123,
          "eventId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
          "name": "Borscht",
          "price": 120.50,
          "venueId": 456
        },
        "contentType": "application/json",
        "encoded": false
      },
      "description": "a DishCreated event",
      "generators": {
        "body": {
          "$.eventId": {
            "type": "Uuid"
          }
        }
      },
      "key": "ca0752b0",
      "matchingRules": {
        "body": {
          "$.dishId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.eventId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.name": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.price": {
            "combine": "AND",
            "matchers": [
              {
                "match": "decimal"
              }
            ]
          },
          "$.venueId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json",
        "eventType": "DishCreated"
      },
      "pending": false,
      "type": "Asynchronous/Messages"
    },
