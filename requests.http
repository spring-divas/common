### Feedo Microservice Platform - Exam Request Collection
### Base URL of the ingress (single entry point). Forward the ingress-nginx controller to the host first:
### kubectl port-forward -n ingress-nginx svc/ingress-nginx-controller 8080:80
@baseUrl = http://localhost:8080/api

###############################################################################
# 1. ДЕМОНСТРАЦІЯ: Реєстрація та Автентифікація (user-service)
###############################################################################

### 1.1 Реєстрація нового клієнта (Customer)
# @name registerCustomer
POST {{baseUrl}}/user/customer
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "Password123!",
  "firstName": "Олександр",
  "lastName": "Петренко"
}

### 1.2 Реєстрація менеджера закладу (Venue Manager)
# @name registerManager
POST {{baseUrl}}/user/manager
Content-Type: application/json

{
  "email": "manager@example.com",
  "password": "Password123!",
  "firstName": "Ірина",
  "lastName": "Коваленко"
}

### 1.3 Логін користувача та отримання JWT-токена
# @name login
POST {{baseUrl}}/auth/token
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "Password123!"
}

> {%
    client.global.set("authToken", response.body.token);
%}


###############################################################################
# 2. БІЗНЕС-ОПЕРАЦІЯ 1: Заклад та Меню (venue-and-menu-service)
# Міжсервісна взаємодія:
# - Створення страви зберігає сутність та подію в OutboxEvent в одній @Transactional
# - Outbox Processor публікує подію в топік Kafka 'dish-events'
# - order-service споживає подію та синхронізує локальну репліку страв
###############################################################################

### 2.1 Створення закладу
# @name createVenue
POST {{baseUrl}}/venue
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Ресторан Дива",
  "address": "м. Київ, вул. Хрещатик, 10"
}

### 2.2 Створення категорії страв
# @name createCategory
POST {{baseUrl}}/category
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "venueId": 1,
  "name": "Основні страви"
}

### 2.3 Створення алергену
# @name createAllergen
POST {{baseUrl}}/allergen
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Глютен"
}

### 2.4 Створення інгредієнта з алергеном
# @name createIngredient
POST {{baseUrl}}/ingredient
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Борошно вищого ґатунку",
  "quantity": 50,
  "allergens": [1]
}

### 2.5 Створення страви (генерує Transactional Outbox подію в Kafka dish-events)
# @name createDish
POST {{baseUrl}}/dish
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "venueId": 1,
  "category": 1,
  "name": "Український борщ із пампушками",
  "description": "Традиційний борщ із яловичиною, подається з часниковими пампушками та сметаною",
  "price": 185.50,
  "ingredients": [1]
}

### 2.6 Генерація динамічного PDF-меню закладу
# @name getMenuPdf
GET {{baseUrl}}/menu/1/pdf
Authorization: Bearer {{authToken}}


###############################################################################
# 3. БІЗНЕС-ОПЕРАЦІЯ 2: Оформлення Замовлення (order-service)
# Міжсервісна взаємодія:
# - order-service перевіряє користувача у user-service через @HttpExchange
# - order-service перевіряє страви та ціни у venue-service через ResilientVenueClient
# - Створює замовлення зі статусом PENDING
# - Зберігає подію ORDER_CREATED у OutboxEvent та відправляє у Kafka 'order-created'
###############################################################################

### 3.1 Створення замовлення клієнтом
# @name createOrder
POST {{baseUrl}}/order
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Correlation-Id: test-order-corr-001

{
  "userId": 1,
  "venueId": 1,
  "tableId": 5,
  "items": [
    {
      "dishId": 1,
      "quantity": 2
    }
  ]
}

### 3.2 Перевірка статусу замовлення
# @name getOrder
GET {{baseUrl}}/order/1
Authorization: Bearer {{authToken}}
X-Correlation-Id: test-order-corr-001


###############################################################################
# 4. БІЗНЕС-ОПЕРАЦІЯ 3: Оплата Замовлення (payment-service)
# Міжсервісна взаємодія:
# - payment-service приймає запит з унікальним Idempotency-Key
# - gRPC двоспрямований стрімінг між order-service та payment-service
# - При успіху статус замовлення змінюється на PAID
###############################################################################

### 4.1 Проведення платежу з ідемпотентним ключем
# @name createPayment
POST {{baseUrl}}/payment
Content-Type: application/json
Idempotency-Key: idempotency-key-order-1-attempt-1
Authorization: Bearer {{authToken}}
X-Correlation-Id: test-payment-corr-001

{
  "orderId": 1
}

### 4.2 Оплата замовлення через Order Service (міжсервісний виклик через gRPC/REST)
# @name payOrder
POST {{baseUrl}}/order/1/pay
Content-Type: application/json
Authorization: Bearer {{authToken}}


###############################################################################
# 5. БІЗНЕС-ОПЕРАЦІЯ 4: Відгук та Синхронізація Рейтингу (review-service)
# Міжсервісна взаємодія:
# - review-service звертається до order-service (через CircuitBreaker/OrderClient),
#   щоб підтвердити, що клієнт дійсно замовляв цю страву
# - При публікації відгуку розраховується середній рейтинг
# - Синхронізація нового рейтингу у venue-service через gRPC (RatingSyncGrpcService)
###############################################################################

### 5.1 Залишити відгук на страву
# @name reviewDish
POST {{baseUrl}}/review/dish
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "dishId": 1,
  "content": "Дуже смачний борщ! Пампушки теплі та запашні.",
  "rating": 5
}

### 5.2 Залишити відгук на заклад
# @name reviewVenue
POST {{baseUrl}}/review/venue
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "venueId": 1,
  "content": "Чудова атмосфера та швидке обслуговування.",
  "rating": 5
}


###############################################################################
# 6. ТЕСТУВАННЯ ВІДМОВОСТІЙКОСТІ ТА ОБМЕЖЕНЬ (Rate Limiter & Circuit Breaker)
###############################################################################

### 6.1 Перевірка Rate Limiter (швидка серія запитів призводить до HTTP 429 ProblemDetail)
GET {{baseUrl}}/order
Authorization: Bearer {{authToken}}

### 6.2 Перевірка валідації DTO (ProblemDetail HTTP 400 із картою помилок)
POST {{baseUrl}}/payment
Content-Type: application/json
Idempotency-Key: valid-key

{
  "orderId": null
}

### 6.3 Перевірка відсутності обов'язкового заголовка Idempotency-Key (ProblemDetail HTTP 400)
POST {{baseUrl}}/payment
Content-Type: application/json

{
  "orderId": 1
}

### 6.4 Перевірка 404 Not Found (ProblemDetail HTTP 404)
GET {{baseUrl}}/order/999999
Authorization: Bearer {{authToken}}
