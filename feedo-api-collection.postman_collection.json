    {
      "name": "2. Scenario: view the menu (no token)",
      "description": "The menu is public, so guests can see it before ordering.",
      "item": [
        {
          "name": "2.1 Get venue menu",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/menu?venueId={{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ],
              "query": [
                {
                  "key": "venueId",
                  "value": "{{venueId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Menu contains the created dish', () => {",
                  "    const ids = pm.response.json().map(dish => dish.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('dishId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Download menu PDF",
          "request": {
            "method": "GET",
            "header": [],
