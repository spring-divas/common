    {
      "name": "5. Guest order (no token)",
      "description": "Guests can order without an account. The response contains an access token that lets the guest pay or cancel only this order (X-Order-Token header).",
      "item": [
        {
          "name": "5.1 Create guest order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venueId\": {{venueId}},\n  \"tableId\": {{tableId}},\n  \"items\": [\n    {\n      \"dishId\": {{dishId}},\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('guestOrderId', pm.response.json().id);",
                  "pm.collectionVariables.set('guestOrderToken', pm.response.json().accessToken);",
                  "pm.test('Access token is returned', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Pay guest order with access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Order-Token",
                "value": "{{guestOrderToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/order/{{guestOrderId}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "{{guestOrderId}}",
                "pay"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 Pay guest order without access token",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/order/{{guestOrderId}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "{{guestOrderId}}",
                "pay"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Body is ProblemDetail', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(403);",
                  "    pm.expect(body).to.have.property('title');",
                  "});"
                ]
              }
            }
          ]
        },
        {
