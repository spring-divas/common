{
  "info": {
    "_postman_id": "feedo-microservices-exam-collection",
    "name": "Feedo Microservice Platform - Exam Collection",
    "description": "Runnable collection for the Feedo demo. Run the folders in order with the Collection Runner: it logs in as the admin, registers a customer, sets up a venue, views the menu, creates and pays an order, reviews the dish and shows the guest order, idempotency, ProblemDetail errors and rate limiting. Set adminPassword to ADMIN_PASSWORD from user-secret. baseUrl points to the ingress controller: kubectl port-forward -n ingress-nginx svc/ingress-nginx-controller 8080:80",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "description": "Log in as the initial admin (ADMIN_EMAIL / ADMIN_PASSWORD from user-secret), register a new customer and log in as the customer. Tokens are stored in collection variables.",
      "item": [
        {
          "name": "0.1 Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/user/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "customer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Олександр\",\n  \"lastName\": \"Петренко\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('customerEmail', `customer.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerId', pm.response.json().id);",
                  "pm.test('Role is CUSTOMER', () => pm.expect(pm.response.json().role).to.eql('CUSTOMER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 Customer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.text());"
                ]
              }
            }
          ]
        }
      ]
    },
