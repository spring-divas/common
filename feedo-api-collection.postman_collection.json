    {
      "name": "3. Scenario: create and pay an order (customer)",
      "description": "order-service checks the dishes from its replica, loads the customer profile from user-service (REST), stores an outbox event for Kafka and pays through payment-service (gRPC bidirectional stream).",
      "item": [
        {
          "name": "3.1 Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "postman-order-{{customerId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venueId\": {{venueId}},\n  \"tableId\": {{tableId}},\n  \"items\": [\n    {\n      \"dishId\": {{dishId}},\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// order-service receives dishes asynchronously from venue-service (gRPC stream / Kafka)",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);",
                  "pm.test('Order belongs to the customer', () => pm.expect(pm.response.json().userId).to.eql(Number(pm.collectionVariables.get('customerId'))));",
                  "pm.test('Order is NEW', () => pm.expect(pm.response.json().status).to.eql('NEW'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Get order",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Get my orders",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('List contains the order', () => {",
                  "    const ids = pm.response.json().map(order => order.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('orderId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Pay order (gRPC)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "{{orderId}}",
                "pay"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Order is PAID', () => pm.expect(pm.response.json().status).to.eql('PAID'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Scenario: review a dish (customer)",
      "description": "A dish can be reviewed only after the order is READY. review-service checks the order in order-service (REST) and sends the new rating to venue-service (gRPC).",
      "item": [
        {
          "name": "4.1 Mark order READY (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order",
                "{{orderId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venueId\": {{venueId}},\n  \"tableId\": {{tableId}},\n  \"items\": [\n    {\n      \"dishId\": {{dishId}},\n      \"quantity\": 2\n    }\n  ],\n  \"status\": \"READY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Order is READY', () => pm.expect(pm.response.json().status).to.eql('READY'));"
                ]
              }
