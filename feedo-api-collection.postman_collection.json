    {
      "name": "6. Payment idempotency (admin)",
      "description": "Repeating a payment with the same Idempotency-Key returns the same payment.",
      "item": [
        {
          "name": "6.1 Create payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}}\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('paymentKey', `postman-${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of [200, 201]', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('paymentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Repeat payment with the same key",
