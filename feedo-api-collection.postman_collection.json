              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of [200, 201]', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('Same payment is returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('paymentId'))));"
                ]
              }
            }
          ]
        }
